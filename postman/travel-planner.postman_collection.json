{
  "info": {
    "name": "Travel Planner API",
    "description": "CRUD API for travel projects and places (artworks from the Art Institute of Chicago API).\n\nSet the `base_url` collection variable if the server runs on a different host/port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "place_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": [""]
            },
            "description": "Returns service status and version."
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "active", "disabled": true, "description": "Optional filter: active | completed" }
              ]
            },
            "description": "Returns paginated list of projects. Optional `status` filter."
          }
        },
        {
          "name": "Create project (minimal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": ["{{base_url}}"],
              "path": ["projects"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chicago Art Trip\"\n}"
            },
            "description": "201 Created. Only `name` is required."
          }
        },
        {
          "name": "Create project (full, with places)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": ["{{base_url}}"],
              "path": ["projects"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chicago Art Trip\",\n  \"description\": \"Visiting famous artworks at the Art Institute\",\n  \"start_date\": \"2026-07-01\",\n  \"places\": [\n    { \"external_id\": 27992 },\n    { \"external_id\": 28560 }\n  ]\n}"
            },
            "description": "Creates a project together with places in one request. Each place is validated against the AIC API. Max 10 places.\n\n27992 = A Sunday on La Grande Jatte, 28560 = Nighthawks."
          }
        },
        {
          "name": "Create project — validation error (empty name)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": ["{{base_url}}"],
              "path": ["projects"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "description": "Expected: 422 Unprocessable Entity (name must be at least 1 character)."
          }
        },
        {
          "name": "Create project — too many places (>10)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": ["{{base_url}}"],
              "path": ["projects"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Too Big Trip\",\n  \"places\": [\n    { \"external_id\": 1 }, { \"external_id\": 2 }, { \"external_id\": 3 },\n    { \"external_id\": 4 }, { \"external_id\": 5 }, { \"external_id\": 6 },\n    { \"external_id\": 7 }, { \"external_id\": 8 }, { \"external_id\": 9 },\n    { \"external_id\": 10 }, { \"external_id\": 11 }\n  ]\n}"
            },
            "description": "Expected: 422 — a project can contain at most 10 places."
          }
        },
        {
          "name": "Get single project",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}"]
            },
            "description": "200 OK with project and its places. 404 if not found."
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed Trip\",\n  \"description\": \"Updated description\",\n  \"start_date\": \"2026-08-15\"\n}"
            },
            "description": "Partial update — all fields optional. 404 if project not found."
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}"]
            },
            "description": "204 No Content on success.\n\n409 Conflict if any place in the project is already marked as visited."
          }
        }
      ]
    },
    {
      "name": "Places",
      "item": [
        {
          "name": "List places in project",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "places"]
            },
            "description": "Returns all places attached to the project."
          }
        },
        {
          "name": "Add place to project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "places"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_id\": 27992\n}"
            },
            "description": "Validates the artwork in the AIC API before storing.\n\n201 on success, 404 if artwork doesn't exist in AIC, 409 if duplicate, 422 if project already has 10 places."
          }
        },
        {
          "name": "Add place — not found in AIC API",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "places"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_id\": 999999999\n}"
            },
            "description": "Expected: 404 — artwork does not exist in the Art Institute of Chicago API."
          }
        },
        {
          "name": "Add place — duplicate in project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "places"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_id\": 27992\n}"
            },
            "description": "Run 'Add place to project' first, then this one with the same external_id.\n\nExpected: 409 Conflict — the same external place cannot be added to one project twice."
          }
        },
        {
          "name": "Get single place",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places/{{place_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "places", "{{place_id}}"]
            },
            "description": "200 OK. 404 if the place doesn't belong to this project."
          }
        },
        {
          "name": "Update place notes",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places/{{place_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "places", "{{place_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Go early in the morning, less crowded\"\n}"
            },
            "description": "Updates user notes for the place."
          }
        },
        {
          "name": "Mark place as visited",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places/{{place_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "places", "{{place_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visited\": true\n}"
            },
            "description": "Marks the place as visited. When ALL places in a project are visited, the project status automatically becomes `completed`."
          }
        }
      ]
    }
  ]
}